# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# private_tweet — Production Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Steps:
#   1. cp .env.production.example .env.production
#   2. Fill in every value marked CHANGE_ME
#   3. ./deploy.sh
#
# Never commit .env.production to version control.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=tweet
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_database_password
POSTGRES_DB=private_tweet

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_use_a_strong_redis_password

# ── MinIO (object storage — for future media upload feature) ──────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_use_a_strong_minio_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Token lifetimes (optional — shown values are defaults)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Site URL ──────────────────────────────────────────────────────────────────
# Your server's domain or IP — no trailing slash.
# Used for CORS and cookie scope.
# Example:  http://192.168.1.10   or   https://tweet.example.com
WEB_URL=http://CHANGE_ME_your_server_ip_or_domain
